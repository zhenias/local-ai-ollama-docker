# ─── Porty ────────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
WEBUI_PORT=3000
PIPELINES_PORT=9099

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Jak długo model trzymać w pamięci po ostatnim użyciu (0 = wyłącz, -1 = zawsze)
OLLAMA_KEEP_ALIVE=24h
# Ile żądań jednocześnie obsługiwać
OLLAMA_NUM_PARALLEL=2

# ─── Open WebUI ───────────────────────────────────────────────────────────────
# Zmień na losowy, bezpieczny klucz!
WEBUI_SECRET_KEY=ChangeMe123!
# Nazwa wyświetlana w interfejsie
WEBUI_NAME=AILocal
# Czy pozwolić na rejestrację nowych kont (false = tylko admin)
ENABLE_SIGNUP=true
# Domyślny model po zalogowaniu (np. llama3.2 – musi być pobrany)
DEFAULT_MODELS=

# ─── Pipelines (MCP / własne narzędzia) ──────────────────────────────────────
PIPELINES_API_KEY=0p3n-w3bu!
